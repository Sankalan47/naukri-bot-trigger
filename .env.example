# Copy this file to .env and fill in your values. Never commit .env to git.

# From BotFather: https://t.me/botfather
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Your Telegram user ID — get it from @userinfobot
ALLOWED_USER_ID=123456789

# Naukri credentials (required for automatic re-login when session expires)
NAUKRI_EMAIL=your_email@example.com
NAUKRI_PASSWORD=your_naukri_password

# Only needed on 32-bit ARM (e.g. Raspberry Pi 3B) where Playwright has no
# prebuilt Node.js/Chromium — point these at apt-installed system binaries.
# PLAYWRIGHT_NODEJS_PATH=/usr/bin/node
# CHROMIUM_PATH=/usr/bin/chromium

# Naukri's bot protection (Akamai) returns "Access Denied" to headless
# Chromium. Set to false and run under a virtual display (e.g. Xvfb via
# xvfb-run) so the browser launches headed instead.
# HEADLESS=false
